{
  "name": "@deja-run/cli",
  "version": "0.1.0",
  "description": "The deja CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deja-run/deja.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/deja-run/deja#readme",
  "bugs": {
    "url": "https://github.com/deja-run/deja/issues"
  },
  "type": "module",
  "bin": {
    "deja": "./dist/deja.js"
  },
  "exports": {
    "./reporter": {
      "types": "./dist/src/reporter.d.ts",
      "bun": "./src/reporter.ts",
      "default": "./dist/src/reporter.js"
    },
    "./redaction": {
      "types": "./dist/src/redaction.d.ts",
      "bun": "./src/redaction.ts",
      "default": "./dist/src/redaction.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "bun ../../scripts/publish-guard.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@deja-run/core": "workspace:*",
    "@deja-run/maestro": "workspace:*",
    "@deja-run/store-local": "workspace:*",
    "@deja-run/explorer-openclaw": "workspace:*",
    "@deja-run/repair": "workspace:*",
    "@deja-run/semantic-local": "workspace:*",
    "yaml": "^2.9.1"
  }
}
