{
  "name": "@deja-qa/cli",
  "version": "0.1.0",
  "description": "The deja CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seankim-android/deja.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/seankim-android/deja#readme",
  "bugs": {
    "url": "https://github.com/seankim-android/deja/issues"
  },
  "type": "module",
  "bin": {
    "deja": "./dist/deja.js"
  },
  "exports": {
    "./reporter": {
      "bun": "./src/reporter.ts",
      "types": "./dist/src/reporter.d.ts",
      "default": "./dist/src/reporter.js"
    },
    "./redaction": {
      "bun": "./src/redaction.ts",
      "types": "./dist/src/redaction.d.ts",
      "default": "./dist/src/redaction.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deja-qa/core": "workspace:*",
    "@deja-qa/maestro": "workspace:*",
    "@deja-qa/store-local": "workspace:*",
    "@deja-qa/explorer-openclaw": "workspace:*",
    "@deja-qa/repair": "workspace:*",
    "@deja-qa/semantic-local": "workspace:*"
  }
}
