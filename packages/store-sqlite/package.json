{
  "name": "@deja-qa/store-sqlite",
  "version": "0.1.0",
  "description": "SQLite WalkStore (bun:sqlite on Bun, node:sqlite on Node)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seankim-android/deja.git",
    "directory": "packages/store-sqlite"
  },
  "homepage": "https://github.com/seankim-android/deja#readme",
  "bugs": {
    "url": "https://github.com/seankim-android/deja/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "bun ../../scripts/publish-guard.ts"
  },
  "dependencies": {
    "@deja-qa/core": "workspace:*",
    "@deja-qa/store-local": "workspace:*"
  }
}
