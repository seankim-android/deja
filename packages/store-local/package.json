{
  "name": "@deja-qa/store-local",
  "version": "0.1.0",
  "description": "Filesystem + JSON WalkStore",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seankim-android/deja.git",
    "directory": "packages/store-local"
  },
  "homepage": "https://github.com/seankim-android/deja#readme",
  "bugs": {
    "url": "https://github.com/seankim-android/deja/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deja-qa/core": "workspace:*"
  },
  "devDependencies": {
    "@deja-qa/semantic-local": "workspace:*"
  }
}
