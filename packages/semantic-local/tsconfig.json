{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.semantic-local.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "bun"
    ],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "customConditions": [
      "bun"
    ]
  },
  "include": [
    "src",
    "test"
  ]
}
